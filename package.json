{
  "name": "carpenter-furniture-store",
  "version": "1.0.0",
  "description": "Carpenter Furniture E-Commerce and Online Showroom",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "create-admin": "npm run create-admin --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}